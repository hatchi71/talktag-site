    {
      "id": "ko-plain-a1-001",
      "level": "A1",
      "sourceSha256": "4e81a4d55651b8e0ecbf86b767c8a4884e18adbc853ac887129c5d1d733661dd",
      "lines": [
        {
          "index": 1,
          "text": "오늘 저는 새 한국어 수업에 갔어요.",
          "meaning": "Today I went to a new Korean class.",
          "speechSeconds": 5.074,
          "audio": "https://audio.talktag.co.kr/Korean/audio-essays-articles/segments-001/v1-20261016/a1/line-01.mp3?v=d1276f2396ef",
          "sha256": "d1276f2396efc74c823010f1da1e5c18940d98c3afa4fdd1dde8fb6bd786af9d",
          "bytes": 53157
        },
        {
          "index": 2,
          "text": "선생님과 학생들이 친절했어요.",
          "meaning": "The teacher and students were kind.",
          "speechSeconds": 5.01,
          "audio": "https://audio.talktag.co.kr/Korean/audio-essays-articles/segments-001/v1-20261016/a1/line-02.mp3?v=fbe4d13c1a2c",
          "sha256": "fbe4d13c1a2c26fd1aa65fc420ae1ac74c78728620bf54ea1700a1a8c4abdfb4",
          "bytes": 52509
        },
        {
          "index": 3,
          "text": "저는 제 이름을 말했어요.",
          "meaning": "I said my name.",
          "speechSeconds": 4.245,
          "audio": "https://audio.talktag.co.kr/Korean/audio-essays-articles/segments-001/v1-20261016/a1/line-03.mp3?v=e9e175bb0920",
          "sha256": "e9e175bb09205c96e3ec346ccbc679085e29cb0715148859bc514ad98cc7e1a4",
          "bytes": 43533
        },
        {
          "index": 4,
          "text": "옆 사람과 같이 앉았어요.",
          "meaning": "I sat with the person next to me.",
          "speechSeconds": 4.97,
          "audio": "https://audio.talktag.co.kr/Korean/audio-essays-articles/segments-001/v1-20261016/a1/line-04.mp3?v=1481632a2ce4",
          "sha256": "1481632a2ce42c26c7ef031972c04fdd780d6b9f06db7795a7dcdf47020cede4",
          "bytes": 51477
        },
        {
          "index": 5,
          "text": "다음 수업에도 가고 싶어요.",
          "meaning": "I want to go to the next class too.",
          "speechSeconds": 4.24,
          "audio": "https://audio.talktag.co.kr/Korean/audio-essays-articles/segments-001/v1-20261016/a1/line-05.mp3?v=a6a006b0e8e2",
          "sha256": "a6a006b0e8e21079a91f6faa3e7a856500e6dc86409d92da546aca63c5308393",
          "bytes": 42981
        }
      ],
